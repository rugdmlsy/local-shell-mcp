# Shared loopback edge for mcp.xycdev.com.
# Cloudflared points the hostname at 127.0.0.1:8765. Caddy owns that
# listener. Browser/control-plane Morrows paths go directly to :8787, while
# Morrows MCP traffic goes through Local Shell MCP on :8766 so it shares the
# same ChatGPT OAuth boundary as the other MCP integrations.
:8765 {
	bind 127.0.0.1

	@morrows_browser_root {
		method GET
		path /morrows /morrows/
		header Accept *text/html*
	}
	handle @morrows_browser_root {
		redir * /morrows/ui/ 302
	}

	@morrows_mcp path /morrows /morrows/
	handle @morrows_mcp {
		reverse_proxy 127.0.0.1:8766
	}

	@morrows_health path /morrows/health
	handle @morrows_health {
		rewrite * /api/health
		reverse_proxy 127.0.0.1:8787
	}

	handle /morrows/api/* {
		uri strip_prefix /morrows
		reverse_proxy 127.0.0.1:8787
	}

	@morrows_ui_root path /morrows/ui
	handle @morrows_ui_root {
		redir * /morrows/ui/ 308
	}

	handle /morrows/ui/* {
		uri strip_prefix /morrows/ui
		reverse_proxy 127.0.0.1:8787
	}

	handle {
		reverse_proxy 127.0.0.1:8766
	}
}
